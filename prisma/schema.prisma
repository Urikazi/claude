generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id       String @id @default(cuid())
  name     String
  currency String @default("USD")

  // Shopify custom app credentials
  shopifyDomain      String? // e.g. my-store.myshopify.com
  shopifyAccessToken String?

  // Meta Ads
  metaAdAccountId String? // e.g. act_123456789
  metaAccessToken String?

  // Payment processors
  stripeSecretKey    String?
  paypalClientId     String?
  paypalClientSecret String?
  paypalLiveMode     Boolean @default(true)

  feeConfig FeeConfig?
  products  Product[]
  orders    Order[]
  adSpend   AdSpendEntry[]
  syncLogs  SyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fee rates used when a processor's real fee is not available on an order.
/// Shopify's transaction fee applies to every order regardless of gateway.
model FeeConfig {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  shopifyTransactionRate Float @default(0.006) // 0.6%

  stripePercent Float @default(0.029)
  stripeFixed   Float @default(0.30)

  paypalPercent Float @default(0.0349)
  paypalFixed   Float @default(0.49)

  // Anything else (COD, bank transfer, manual gateways)
  defaultPercent Float @default(0)
  defaultFixed   Float @default(0)

  updatedAt DateTime @updatedAt
}

model Product {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyId String?
  title     String
  handle    String?
  imageUrl  String?

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, shopifyId])
  @@index([storeId])
}

/// COGS lives on the variant: the same product can have different costs per size/colour.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyId String?
  sku       String?
  title     String  @default("Default")
  price     Float   @default(0)

  /// Unit cost of goods, entered by the user.
  cogs Float @default(0)
  /// Per-unit shipping/fulfilment cost, entered by the user.
  shippingCost Float @default(0)
  /// Per-unit handling/packaging cost, entered by the user.
  handlingCost Float @default(0)

  lineItems OrderLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, shopifyId])
  @@index([productId])
}

model Order {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyId String?
  name      String? // #1001
  currency  String  @default("USD")

  processedAt DateTime
  financialStatus String? // paid, refunded, partially_refunded...

  /// Gross merchandise value before discounts.
  subtotal      Float @default(0)
  discountTotal Float @default(0)
  shippingTotal Float @default(0)
  taxTotal      Float @default(0)
  /// What the customer actually paid.
  total         Float @default(0)
  refundedTotal Float @default(0)

  /// STRIPE | PAYPAL | SHOPIFY_PAYMENTS | OTHER
  gateway     String @default("OTHER")
  gatewayName String?

  /// Real processor fee pulled from Stripe/PayPal. Null until reconciled.
  processorFeeActual Float?
  /// Estimated processor fee from FeeConfig, always populated.
  processorFeeEstimate Float @default(0)
  /// Shopify transaction fee (0.6% by default).
  shopifyFee Float @default(0)

  lineItems OrderLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, shopifyId])
  @@index([storeId, processedAt])
}

model OrderLineItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  shopifyId       String?
  title           String
  variantTitle    String?
  sku             String?
  quantity        Int     @default(1)
  price           Float   @default(0)
  discountAllocated Float @default(0)

  /// COGS snapshot at sync time so historical PNL does not shift when costs are edited.
  unitCogs     Float @default(0)
  unitShipping Float @default(0)
  unitHandling Float @default(0)

  @@index([orderId])
  @@index([variantId])
}

model AdSpendEntry {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  date     DateTime
  platform String   @default("meta")

  campaignId   String  @default("")
  campaignName String?

  spend       Float @default(0)
  impressions Int   @default(0)
  clicks      Int   @default(0)
  /// Purchases attributed by the platform - used for ROAS sanity checks, not for revenue.
  conversions Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, date, platform, campaignId])
  @@index([storeId, date])
}

model SyncLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  source    String // shopify | meta | stripe | paypal
  status    String // success | error
  message   String?
  records   Int      @default(0)
  startedAt DateTime @default(now())
  endedAt   DateTime?

  @@index([storeId, source, startedAt])
}
