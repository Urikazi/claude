# Local SQLite database. Swap the provider in prisma/schema.prisma for Postgres in production.
DATABASE_URL="file:./dev.db"

# Optional: protect the /api/sync/* endpoints so a cron service can call them.
# Send it as `Authorization: Bearer <token>` or `?token=<token>`.
SYNC_SECRET=""

# API credentials are stored per-store in the database via /dashboard/settings.
# The values below are only used to pre-fill the seed script.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_ACCESS_TOKEN=""
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
