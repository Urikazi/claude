# ---------------------------------------------------------------------------
# Database. Postgres in every environment; hosted providers give you this URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication. Generate all three with:  npm run auth:hash -- 'your password'
# The dashboard stays locked until the first two are set.
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD_HASH=""
SESSION_SECRET=""

# Lets a cron service call /api/sync without a browser session.
# Send as `Authorization: Bearer <token>` or `?token=<token>`.
SYNC_SECRET=""

# ---------------------------------------------------------------------------
# API credentials are stored per-store in the database via /dashboard/settings,
# not here. The values below only pre-fill the seed script.
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
META_AD_ACCOUNT_ID=""
META_ACCESS_TOKEN=""
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Claude API key for the CFO page (dashboard/advisor). Read from the environment rather
# than stored in the database, so it does not sit alongside the provider credentials.
# Without it the page loads and says so; nothing else is affected.
ANTHROPIC_API_KEY=
